source "https://rubygems.org"

# github-pages pins Jekyll 3.9 which is incompatible with Ruby 3.2+.
# Use jekyll directly for local development; GitHub Pages still deploys via its own pipeline.
gem "jekyll", "~> 4.3"
gem "just-the-docs"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "webrick"

group :jekyll_plugins do
  gem "jekyll-remote-theme"
end